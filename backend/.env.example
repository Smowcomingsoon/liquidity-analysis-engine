TWELVE_DATA_API_KEY=your_api_key_here

# Opzionale: notifiche Telegram per gli alert della strategia.
# Setup: cerca @BotFather su Telegram -> /newbot -> copia il token.
# Poi scrivi un messaggio qualsiasi al bot appena creato e apri nel browser
# https://api.telegram.org/bot<TOKEN>/getUpdates per leggere il tuo chat_id
# nel campo "chat":{"id": ...}. Più id separati da virgola per notificare più chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Chi può effettivamente ricevere alert Telegram, anche se altri utenti si
# registrano — per email dell'account, separate da virgola. Lasciare vuoto
# per rimuovere la restrizione (chiunque abbia un chat_id impostato riceve
# gli alert).
TELEGRAM_ALLOWED_EMAILS=you@example.com,friend@example.com

# Opzionale: pannello saldi in sola lettura (tab "Saldi") — usa SOLO gli
# endpoint di lettura account/balance di ciascun exchange, mai un endpoint
# di trading/prelievo. Usa chiavi con permesso di sola lettura.
MEXC_API_KEY=
MEXC_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Chi vede la tab Saldi (per email, separate da virgola) — sono saldi reali,
# visibili solo a chi è in questo elenco.
BALANCE_VISIBLE_EMAILS=you@example.com
